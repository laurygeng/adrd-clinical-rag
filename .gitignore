# ==========================================
# 1. RAG Project Specific Cache, Data & Models
# ==========================================
# Environment variables (NEVER push files containing OPENAI_API_KEY)
.env
.env.*

# Entire knowledge base directory (Contains vector DB, raw PDFs, and cached chunks)
knowledge_base/

# Downloaded LLM or Embedding models (Huge weight files)
models/

# Original authoritative documents
data/

# Output results generated by retrieval tests
retrieval_results/
*.csv


# ==========================================
# 2. Python & Node.js Dependencies
# ==========================================
# Node.js dependencies
node_modules/

# Python bytecode files
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments (Never push massive dependency folders)
venv/
.venv/
env/
ENV/

# Dependency and coverage management
.tox/
.coverage
htmlcov/
pytest_cache/
.pytest_cache/


# ==========================================
# 3. Editor & OS General Ignores
# ==========================================
# VS Code / Cursor / PyCharm
.vscode/
.idea/
*.swp
*.swo

# Mac & Windows System Files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/